# Backend API base URL (must include /api/v1)
VITE_API_URL=http://localhost:8000/api/v1

# Google Maps JavaScript API key.
# Enable "Maps JavaScript API" in Google Cloud Console and restrict the key to
# the domains that actually serve the site (e.g. hediehkindergarten.ir,
# *.hediehkindergarten.ir, localhost:5173). Without a working key the map area
# degrades to a "مشاهده روی نقشه" link instead of breaking the page.
VITE_GOOGLE_MAPS_API_KEY=

# Optional Google Cloud Map ID used for the marker/map styling.
# Leave empty to use the public DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
